layout: null
permalink: /sitemap.xml
---
{%- comment -%}
  The 13 pages of the work order, at their live addresses. Pages opt out
  with sitemap: false (the 404 page).
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
{%- if p.slug and p.sitemap != false %}
  <url><loc>{{ site.url }}{{ p.permalink }}</loc></url>
{%- endif %}
{%- endfor %}
</urlset>
